# Copy to .streamlit/secrets.toml (gitignored) for local runs, and paste the same
# content into Streamlit Cloud > App > Settings > Secrets.
# While there is NO [auth] section, the app uses the old username/password login.

SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-service-role-key"   # service_role key, server-side only (see migrations/002)

[auth]
# Local:  http://localhost:8501/oauth2callback
# Hosted: https://gift-manager.streamlit.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"
# Any long random string, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "CHANGE_ME_LONG_RANDOM_STRING"
# Cookie lifetime = how long "remember me" lasts (Streamlit default is 30 days)
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "xxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
